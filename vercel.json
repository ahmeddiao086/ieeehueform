{
  "rewrites": [
    { "source": "/task/:code", "destination": "/task/index.html" }
  ],
  "headers": [
    {
      "source": "/task/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
